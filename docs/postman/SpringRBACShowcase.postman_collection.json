{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "name": "Spring RBAC Showcase",
    "description": "Walk-through collection for the Spring RBAC Showcase API. Run **Auth → Login** first to populate the `{{token}}` variable; every other request inherits the collection-level Bearer auth from there. Default base URL targets a local backend on port 8098. Default credentials match the demo data seeded with the `demo` profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8098", "type": "string" },
    { "key": "username", "value": "admin@acme.crafted-code.org", "type": "string" },
    { "key": "password", "value": "demo123", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "organizationId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Authenticate and store the returned JWT into the `{{token}}` collection variable. Run this first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('Token stored.');",
                  "} else {",
                  "    console.warn('No token field in response.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renew",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/renew",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "renew"]
            },
            "description": "Exchange the refresh-token cookie for a fresh access token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
