            },
            "url": {
              "raw": "{{baseUrl}}/v1/organizations",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "organizations"]
            },
            "description": "Requires ORGANIZATION_CREATE. Will fail if the caller already belongs to an organization."
